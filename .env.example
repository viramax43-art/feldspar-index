TELEGRAM_BOT_TOKEN=

# User API для сбора СВОИХ голосовых из всех чатов аккаунта
# Получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=session_user
# Если MTProto DC заблокированы на сервере — SOCKS5/HTTP proxy для Telethon:
# TELEGRAM_PROXY=socks5://user:pass@host:1080
TELEGRAM_PROXY=
# Скачивание файлов Bot API. У aiogram дефолт 30с — MP4 часто не успевает
TELEGRAM_DOWNLOAD_TIMEOUT_SEC=300

# GigaChat Studio: https://developers.sber.ru/studio/workspaces
# Authorization key (base64 client_id:client_secret), не обычный access token
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_MAX_TOKENS=500
GIGACHAT_HISTORY_TURNS=6
GIGACHAT_TIMEOUT_SEC=60
# GigaChat подписан российским корневым CA (Минцифры). Соберите bundle:
#   python scripts/setup_gigachat_certs.py
# и укажите путь ниже. Оставляйте VERIFY_SSL=true при наличии bundle.
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE_FILE=./assets/certs/russian_trusted_ca.pem

# Ударения перед TTS (модель RUAccent скачивается при первом ответе)
ENABLE_RUACCENT=true
RUACCENT_MODEL_SIZE=turbo3.1
RUACCENT_USE_DICTIONARY=true
RUACCENT_WORKDIR=./data/models/ruaccent
CUSTOM_ACCENTS_PATH=./data/custom_accents_ru.json

# Распознавание Telegram voice (CPU оставляет CUDA для XTTS)
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru
STT_BEAM_SIZE=3
STT_CHUNK_SECONDS=4
STT_MAX_VOICE_SECONDS=180
STT_MAX_ANALYTICS_CHUNKS=8
TELEGRAM_EDIT_INTERVAL_SEC=1.1
# Видео: auto = определить язык ролика и зафиксировать (не форсить ru)
VIDEO_DUB_STT_LANGUAGE=auto
# Отдельная модель для видео (чат остаётся STT_MODEL_SIZE=small).
# medium точнее на шуме/английском, но медленнее и качает ~1.5 ГБ при первом запуске.
VIDEO_DUB_STT_MODEL_SIZE=medium
VIDEO_DUB_STT_VAD=false
VIDEO_DUB_STT_BEAM_SIZE=8
VIDEO_DUB_STT_CHUNK_SEC=40
VIDEO_DUB_STT_OVERLAP_SEC=2.5
VIDEO_DUB_STT_NO_SPEECH_THRESHOLD=0.45
# Тихий/ASMR режим (кнопка после загрузки): усиление перед Whisper
VIDEO_DUB_QUIET_STT_TARGET_DB=-12
VIDEO_DUB_QUIET_STT_NO_SPEECH_THRESHOLD=0.12
VIDEO_DUB_QUIET_STT_MIN_COVERAGE=0.08

# Лимиты автосбора из истории аккаунта (пул референсов)
ACCOUNT_COLLECT_LIMIT=500
ACCOUNT_COLLECT_PER_DIALOG=200
ACCOUNT_COLLECT_MAX_SECONDS=3600
ACCOUNT_COLLECT_MIN_DURATION=2
ACCOUNT_COLLECT_MAX_DURATION=90
# 0 = сканировать всю историю каждого чата
ACCOUNT_COLLECT_MESSAGES_PER_DIALOG=0
# Параллельность: загрузка/обработка и сканирование чатов
# SCAN=1 — иначе Telegram даёт FloodWait ~15–20с
ACCOUNT_COLLECT_WORKERS=6
ACCOUNT_COLLECT_SCAN_WORKERS=1

# Сколько лучших секунд/файлов брать в итоговый XTTS-профиль
PROFILE_MAX_SECONDS=180
PROFILE_MAX_FILES=40

DEVICE=cuda
# На ноутбуке с встроенной + NVIDIA: всегда берём дискретную карту
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID
USE_FP16=true
MAX_TEXT_LENGTH=800
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# Hybrid: seamless_m4t | auto/xtts | silero | mockingbird | voxcpm2 | openrouter_fish
TTS_ENGINE=xtts
# OpenRouter Fish Audio (cloud TTS + voice clone)
# OPENROUTER_API_KEY=
# Бесплатный :free слабее по ударениям/интонации RU. Платный: fish-audio/s2.1-pro
# OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_TTS_FORMAT=mp3
# OPENROUTER_TTS_TIMEOUT_SEC=120
# Free tier ≈ 20 запросов/мин — пауза между запросами синтеза, чтобы длинное видео не упиралось в 429
# OPENROUTER_TTS_MIN_INTERVAL_SEC=3.1
SEAMLESS_MODEL_ID=facebook/hf-seamless-m4t-medium
SEAMLESS_SPEAKER_ID=0
# VoxCPM2 — на GPU от 8 ГБ (сервер). На 4 ГБ не влезет.
# VOXCPM_MODEL_ID=openbmb/VoxCPM2
# VOXCPM_CFG_VALUE=2.0
# VOXCPM_INFERENCE_TIMESTEPS=10
# VOXCPM_TIMEOUT_SEC=180
# 0 = без ограничения длительности
VIDEO_DUB_MAX_SECONDS=0
VIDEO_DUB_MAX_MB=19
# Large MP4 without web studio: Telethon / URL / data/inbox/dub
VIDEO_DUB_USE_TELETHON=true
VIDEO_DUB_MAX_DOWNLOAD_MB=512
VIDEO_DUB_INBOX_DIR=./data/inbox/dub
VIDEO_DUB_OUTPUT_DIR=./output
VIDEO_DUB_BOT_UPLOAD_MB=49
# AutoDub-style mix: исходный звук / озвучка (duck) или replace = фон без речи
VIDEO_DUB_MIX_MODE=replace
VIDEO_DUB_SEPARATION=auto
VIDEO_DUB_SEPARATION_DEVICE=cpu
VIDEO_DUB_SPEECH_MASK_GAIN=0.28
VIDEO_DUB_VOCAL_LEAK=0.32
VIDEO_DUB_DUCK_FLOOR=0.28
VIDEO_DUB_BG_VOLUME=0.55
VIDEO_DUB_VOICE_VOLUME=1.0
# Bed under placed TTS: 0.49 = дефолт 0.70 × ещё −30% (не в сумме); вне реплики — полная громкость
VIDEO_DUB_SPEECH_DUCK=0.49
# Насколько раньше оригинального начала реплики можно стартовать при переполнении таймлайна
VIDEO_DUB_LAYOUT_MAX_EARLY_SEC=1.5
# Отброс whisper-галлюцинаций на стонах/шуме (высокий no_speech + низкий logprob)
VIDEO_DUB_DROP_NO_SPEECH_PROB=0.6
VIDEO_DUB_DROP_MIN_LOGPROB=-1.0
# Сколько реплик за видео можно переперевести короче при переполнении слота
VIDEO_DUB_OVERFLOW_RETRANSLATE=8
# Tempo fit выключен (silence-borrow); 1.0 = без ускорения/замедления
VIDEO_DUB_MIN_SPEED=1.0
VIDEO_DUB_MAX_SPEED=1.0
# минимальная пауза между репликами озвучки
VIDEO_DUB_PHRASE_GAP_SEC=0.12
VIDEO_DUB_MIN_PHRASE_GAP_SEC=0.12
# можно выехать за слот STT на 1–2с, чтобы не обрезать конец фразы
VIDEO_DUB_SLOT_SLACK_SEC=2.0
VIDEO_DUB_CLONE_MAX_SEC=24
VIDEO_DUB_CLONE_MAX_CLIPS=4
VIDEO_DUB_CLONE_MIN_CLIP_SEC=2.4
VIDEO_DUB_CLONE_FALLBACK_SEC=12
VIDEO_DUB_CLONE_DENOISE=true
VIDEO_DUB_CLONE_DENOISE_SNR_DB=14
VIDEO_DUB_CLONE_DENOISE_PROP=0.72
# Веб-студия дубляжа (крупные файлы без лимита Telegram)
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_MAX_UPLOAD_MB=512
WEB_USER_ID=1327953308
WEB_PUBLIC_URL=http://127.0.0.1:8765
# На GPU-сервере — публичный IP без домена (порт 80, без :порта в URL):
# WEB_HOST=0.0.0.0
# WEB_PORT=80
# WEB_PUBLIC_URL=http://ВАШ_ПУБЛИЧНЫЙ_IP
# MockingBird (отдельный venv). Откат: TTS_ENGINE=auto
# MOCKINGBIRD_ROOT=./third_party/MockingBird
# MOCKINGBIRD_PYTHON=./third_party/mockingbird-venv/Scripts/python.exe
# MOCKINGBIRD_ENCODER=./data/mockingbird/encoder.pt
# MOCKINGBIRD_SYNTHESIZER=./data/mockingbird/synthesizer.pt
# MOCKINGBIRD_VOCODER=./data/mockingbird/vocoder.pt
SILERO_MODEL_PATH=./assets/tts/silero/v5_5_ru.pt
SILERO_SPEAKER=xenia
SILERO_DEVICE=cpu
SILERO_CPU_THREADS=4
XTTS_TIMEOUT_SEC=120
ENABLE_AUDIO_CACHE=true
AUDIO_CACHE_DIR=./data/cache/tts
# Короткие предложения объединяются в фразы (темп/интонация/underrun)
PHRASE_MIN_CHARS=40
PHRASE_SOFT_MAX_CHARS=110
PHRASE_MAX_CHARS=170

# Ощущение живого обзвона (гудок → алло → ответ voice-сообщениями)
CALL_FEEL_ENABLED=true
CALL_FEEL_RINGBACK_PATH=./assets/call/ringback.ogg
CALL_FEEL_RING_DELAY_SEC=1.1
CALL_FEEL_PICKUP_DELAY_SEC=0.55
CALL_FEEL_ALO_TEXT=Алло? Да, слушаю.
# Прогрев «алло» клоном на старте (0 = выкл). Нужен профиль этого user_id.
CALL_FEEL_WARMUP_USER_ID=0
CALL_FEEL_EARLY_FIRST_PHRASE=true
CALL_FEEL_MIN_FIRST_CHARS=12
CALL_FEEL_MIN_REST_CHARS=24

# Живой Telegram-звонок (Telethon user-аккаунт) + barge-in
CALL_ENABLED=true
CALL_BARGE_IN_ENABLED=true
CALL_VAD_SILENCE_MS=750
CALL_VAD_SPEECH_MS=250
CALL_PCM_SAMPLE_RATE=48000
CALL_RING_TIMEOUT_SEC=45
CALL_STOP_PHRASES=стоп,подожди,подождите,молча,не говори,заткнись,хватит
CALL_TOPIC_SHIFT_PHRASES=другой вопрос,сменим тему,не об этом,погодите про другое,слушай другое

DEFAULT_LANGUAGE=ru
MAX_REFERENCE_SECONDS=180
MIN_REFERENCE_SECONDS=30
MIN_VOICE_MESSAGES=3
MAX_VOICE_MESSAGES=500
ENABLE_DENOISE=false
ENABLE_AI_AUDIO_MARKER=false
AI_MARKER_TEXT=Синтезировано искусственным интеллектом.
DATA_DIR=./data
LOG_LEVEL=INFO
TTS_QUEUE_SIZE=1
DEFAULT_SPEED=1.0
DEFAULT_TEMPERATURE=0.75
DEFAULT_INTONATION=expressive
MODEL_CACHE_DIR=
